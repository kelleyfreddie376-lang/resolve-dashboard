<title>Login | Resolve</title>

<style>
    * {
        box-sizing: border-box;
    }

    :root {
        --bg: #080a10;
        --card: rgba(18, 21, 31, 0.88);
        --border: rgba(255, 255, 255, 0.08);
        --text: #ffffff;
        --muted: #9da4b8;
        --primary: #5865f2;
        --primary-hover: #4752c4;
    }

    html,
    body {
        margin: 0;
        min-height: 100%;
    }

    body {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;

        background:
            radial-gradient(
                circle at 50% -10%,
                rgba(88, 101, 242, 0.22),
                transparent 42%
            ),
            radial-gradient(
                circle at 10% 90%,
                rgba(88, 101, 242, 0.08),
                transparent 35%
            ),
            var(--bg);

        color: var(--text);
        font-family:
            Inter,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            Arial,
            sans-serif;
    }

    .page {
        width: 100%;
        max-width: 460px;
    }

    .brand {
        text-align: center;
        margin-bottom: 28px;
    }

    .logo {
        width: 64px;
        height: 64px;
        margin: 0 auto 18px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 18px;

        background:
            linear-gradient(
                145deg,
                #6672ff,
                #5865f2
            );

        box-shadow:
            0 12px 40px rgba(88, 101, 242, 0.35);

        font-size: 30px;
        font-weight: 800;
        letter-spacing: -2px;
    }

    .brand-name {
        font-size: 25px;
        font-weight: 750;
        letter-spacing: -0.6px;
    }

    .brand-name span {
        color: #7180ff;
    }

    .brand-subtitle {
        margin-top: 7px;
        color: var(--muted);
        font-size: 14px;
    }

    .card {
        position: relative;
        overflow: hidden;

        padding: 34px;

        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 20px;

        box-shadow:
            0 30px 80px rgba(0, 0, 0, 0.45),
            inset 0 1px 0 rgba(255, 255, 255, 0.03);

        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
    }

    .card::before {
        content: "";

        position: absolute;
        top: 0;
        left: 15%;
        right: 15%;
        height: 1px;

        background:
            linear-gradient(
                90deg,
                transparent,
                rgba(88, 101, 242, 0.8),
                transparent
            );
    }

    .welcome {
        text-align: center;
    }

    .welcome h1 {
        margin: 0;
        font-size: 28px;
        letter-spacing: -0.8px;
    }

    .welcome p {
        margin: 12px 0 0;

        color: var(--muted);
        font-size: 15px;
        line-height: 1.6;
    }

    .login-button {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 11px;

        width: 100%;
        margin-top: 28px;
        padding: 15px 18px;

        border-radius: 12px;

        background: var(--primary);
        color: white;

        text-decoration: none;
        font-size: 15px;
        font-weight: 700;

        box-shadow:
            0 8px 24px rgba(88, 101, 242, 0.22);

        transition:
            transform 0.18s ease,
            background 0.18s ease,
            box-shadow 0.18s ease;
    }

    .login-button:hover {
        background: var(--primary-hover);

        transform: translateY(-2px);

        box-shadow:
            0 12px 30px rgba(88, 101, 242, 0.32);
    }

    .login-button:active {
        transform: translateY(0);
    }

    .discord-icon {
        width: 21px;
        height: 21px;
        display: block;
    }

    .security {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;

        margin-top: 17px;

        color: #737b91;
        font-size: 12px;
    }

    .security-icon {
        font-size: 13px;
    }

    .features {
        display: grid;
        grid-template-columns: repeat(3, 1fr);

        margin-top: 28px;

        border-top: 1px solid var(--border);
        padding-top: 26px;
    }

    .feature {
        text-align: center;
        padding: 0 8px;
    }

    .feature + .feature {
        border-left: 1px solid var(--border);
    }

    .feature-icon {
        font-size: 20px;
        margin-bottom: 9px;
    }

    .feature-title {
        font-size: 12px;
        font-weight: 700;
    }

    .feature-text {
        margin-top: 4px;

        color: #737b91;
        font-size: 10px;
        line-height: 1.4;
    }

    .footer {
        margin-top: 22px;

        text-align: center;

        color: #62697c;
        font-size: 11px;
    }

    @media (max-width: 520px) {
        body {
            padding: 16px;
        }

        .card {
            padding: 26px 20px;
            border-radius: 17px;
        }

        .welcome h1 {
            font-size: 25px;
        }

        .features {
            grid-template-columns: 1fr;
            gap: 18px;
        }

        .feature + .feature {
            border-left: none;
            padding-top: 18px;
            border-top: 1px solid var(--border);
        }
    }
</style>
```

</head>

