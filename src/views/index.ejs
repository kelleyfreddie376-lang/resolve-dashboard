<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Resolve Dashboard</title>

    <style>
        body {
            margin: 0;
            background: #0f1117;
            color: white;
            font-family: Arial, sans-serif;
        }

        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 80px 20px;
            text-align: center;
        }

        .logo {
            font-size: 48px;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .logo span {
            color: #5865f2;
        }

        h1 {
            font-size: 42px;
            margin: 20px 0;
        }

        p {
            color: #aeb4c4;
            font-size: 18px;
            line-height: 1.6;
        }

        .button {
            display: inline-block;
            margin-top: 25px;
            padding: 14px 24px;
            background: #5865f2;
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: bold;
            transition: 0.2s;
        }

        .button:hover {
            background: #4752c4;
            transform: translateY(-2px);
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-top: 60px;
        }

        .card {
            background: #181b25;
            border: 1px solid #292d3a;
            border-radius: 12px;
            padding: 25px;
        }

        .card h2 {
            font-size: 20px;
        }

        .card p {
            font-size: 15px;
        }

        @media (max-width: 700px) {
            .cards {
                grid-template-columns: 1fr;
            }

            h1 {
                font-size: 32px;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <div class="logo">
            <span>R</span>esolve
        </div>

        <h1>AI-powered support for Discord.</h1>

        <p>
            Manage your Discord server's AI support,
            tickets, knowledge, and Support Team settings
            from one dashboard.
        </p>

        <a class="button" href="/auth/discord">
            Login with Discord
        </a>

        <div class="cards">

            <div class="card">
                <h2>🧠 Knowledge</h2>
                <p>
                    Manage the approved information
                    Resolve uses to answer your members.
                </p>
            </div>

            <div class="card">
                <h2>🎫 Tickets</h2>
                <p>
                    Configure your support tickets
                    and AI assistance.
                </p>
            </div>

            <div class="card">
                <h2>⚙️ Settings</h2>
                <p>
                    Configure Resolve for each
                    Discord server.
                </p>
            </div>

        </div>

    </div>

</body>
</html>